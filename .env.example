# ---------------------------------------------------------------
# PIKR AI — example environment file
# Copy to `.env` and fill in your own values. Never commit `.env`.
# ---------------------------------------------------------------

# --- Supabase (database, auth, storage) ---
# Server-side (used by server functions / SSR)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
# Privileged key — server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Client-side (Vite build-time, publishable values only)
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# --- AI (chat, agents, embeddings) ---
# OpenAI-compatible gateway key used for completions + embeddings
LOVABLE_API_KEY="your-ai-gateway-key"

# --- Firecrawl (web scraping / search) ---
FIRECRAWL_API_KEY="fc-your-firecrawl-key"

# --- Live Interaction worker (optional, self-hosted) ---
# Run infra/browser-worker locally with this shared token.
PIKR_WORKER_TOKEN="a-long-random-string-you-invent"
PORT=8787
